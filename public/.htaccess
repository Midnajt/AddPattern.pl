# AddPattern — OVH / Apache
# Copied to dist/ on every `npm run build`

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Prefer apex domain (optional: www → non-www)
  RewriteCond %{HTTP_HOST} ^www\.addpattern\.pl$ [NC]
  RewriteRule ^ https://addpattern.pl%{REQUEST_URI} [L,R=301]
</IfModule>

# Security / caching basics
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
